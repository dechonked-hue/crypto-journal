---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const pageTitle = "All posts";
const description = "All posts from the Crypto Journal.";
const allPosts = await Astro.glob("./*.md");
allPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.pubDate).getTime();
  const dateB = new Date(b.frontmatter.pubDate).getTime();
  return dateB - dateA;
});
---

<SiteLayout
  pageTitle={pageTitle}
  description={description}
  backHref="/blog"
  backLabel="Writing"
>
  <section class="page">
    <div class="page-head">
      <h1 class="page-title">All posts</h1>
      <p class="page-intro">{description}</p>
    </div>
    <div class="rows">
      {
        allPosts.map((post) => (
          <a class="row" href={post.url}>
            <span class="r-name">{post.frontmatter.title}</span>
            <span class="r-desc">
              {new Date(post.frontmatter.pubDate).toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })}
            </span>
            <span class="r-arrow">↗</span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
