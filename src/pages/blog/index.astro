---
import SiteLayout from "../../layouts/SiteLayout.astro";
const pageTitle = "Writing";
const description =
  "Execution logs, backtests, automation, self-custody, and accumulation — with numbers, not hype.";
const allPosts = await Astro.glob("./posts/*.md");
allPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.pubDate).getTime();
  const dateB = new Date(b.frontmatter.pubDate).getTime();
  return dateB - dateA;
});
const tags: string[] = [
  ...new Set(allPosts.map((post) => post.frontmatter.tags).flat()),
];
---

<SiteLayout
  pageTitle={pageTitle}
  description={description}
  backHref="/"
  backLabel="Home"
>
  <section class="page">
    <div class="page-head">
      <h1 class="page-title">Writing</h1>
      <p class="page-intro">{description}</p>
    </div>
    <div class="rows">
      {
        allPosts.map((post) => (
          <a class="row" href={post.url}>
            <span class="r-name">{post.frontmatter.title}</span>
            <span class="r-desc">
              {new Date(post.frontmatter.pubDate).toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })}
            </span>
            <span class="r-arrow">↗</span>
          </a>
        ))
      }
    </div>
    {
      tags.length > 0 && (
        <div class="tag-row" style="margin-top: 2.5rem;">
          {tags.map((tag) => (
            <a class="tag-pill" href={`/blog/tags/${tag}`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </section>
</SiteLayout>
