---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const pageTitle = "Technologies";
const allPosts = await Astro.glob("../posts/*.md");
const languages: string[] = [
    ...new Set(allPosts.map((post) => post.frontmatter.languages).flat()),
];
---

<SiteLayout
  pageTitle={pageTitle}
  description="Technologies in the Crypto Journal."
  backHref="/blog"
  backLabel="All posts →"
>
  <section class="page">
    <div class="page-head">
      <h1 class="page-title">Technologies</h1>
      {
        languages.length === 0 && (
          <p class="page-intro">Nothing tagged yet.</p>
        )
      }
    </div>
    {
      languages.length > 0 && (
        <div class="tag-row" style="margin-top: 2.5rem;">
          {languages.map((lang) => (
            <a class="tag-pill" href={`/blog/techs/${lang}`}>
              {lang}
            </a>
          ))}
        </div>
      )
    }
  </section>
</SiteLayout>
