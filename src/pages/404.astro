---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  pageTitle="Page Not Found - 404"
  description="The page you requested could not be found."
  backHref="/"
  backLabel="Home"
>
  <section class="page">
    <div class="page-head">
      <h1 class="page-title" style="font-size: clamp(4rem, 3rem + 6vw, 7rem);">404</h1>
      <p class="page-intro">Page not found. It took a detour, or it was never here.</p>
    </div>
    <div class="tag-row" style="margin-top: 2.5rem;">
      <a class="tag-pill" href="/">← Go home</a>
    </div>
  </section>
</SiteLayout>
