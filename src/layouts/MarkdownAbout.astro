---
import SiteLayout from "./SiteLayout.astro";
const { frontmatter } = Astro.props;
const stack = [
  "Ethereum",
  "Python",
  "Linux",
  "WireGuard",
  "BGP",
  "Traffic Engineering",
  "Cisco",
];
---

<SiteLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  backHref="/"
  backLabel="Home"
>
  <section class="page">
    <div class="page-head">
      <img
        class="about-avatar"
        src="/images/1794140225570.jpg"
        alt="chonk"
        width="112"
        height="112"
      />
      <h1 class="page-title">chonk</h1>
      <p class="about-tagline">GBC validator, crappy bot owner.</p>
    </div>
    <div class="markdown">
      <slot />
    </div>
    <h2
      style="font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.25rem); margin: 3rem 0 0;"
    >
      Stack
    </h2>
    <div class="stack">
      {stack.map((item) => <span class="tag-pill">{item}</span>)}
    </div>
  </section>
</SiteLayout>
